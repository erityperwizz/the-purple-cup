# --- Python virtual environment (reinstall from requirements.txt; never commit) ---
.venv/
venv/
env/

# --- Python bytecode / caches (auto-generated junk) ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- Private build guide: keep the spec out of the public repo ---
# (The spec lives one folder up, outside this repo, but this is a safety net
#  in case a copy ever lands inside brewmetrics/.)
*_SPEC.md
BREWMETRICS_SPEC.md

# --- Streamlit local secrets (never publish credentials) ---
.streamlit/secrets.toml

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# NOTE on data/brewmetrics.db:
# The database is regenerated by data_generation/generate_data.py. We are
# intentionally NOT ignoring it, because the deployed Streamlit app reads it
# directly. We will confirm this choice in Phase 8 (deployment).
